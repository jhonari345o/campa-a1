# Conexion con el sitio (modo trabajador)
SITE_URL=https://TU-SITIO.amplifyapp.com
AGENT_WORKER_TOKEN=el-mismo-token-que-pusiste-en-amplify

# (Opcional) Disparador "bajo demanda". Si tienes un runner en la nube que se
# despierta por HTTP, pon su URL como AGENT_TRIGGER_URL en Amplify. Cuando un
# cliente aprieta "Ejecutar con Mavi", el sitio le hace POST {jobId, platform}
# con el header Authorization: Bearer AGENT_WORKER_TOKEN, y el runner abre el
# navegador solo en ese momento (no hace falta una computadora siempre prendida).
# Si no lo configuras, el trabajo igual queda en cola y worker.py lo toma.

# Modelo del agente (endpoint compatible con OpenAI).
# Menor costo (gratis): Ollama local.
AGENT_BASE_URL=http://localhost:11434/v1
AGENT_MODEL=qwen2.5
AGENT_API_KEY=ollama

# Alternativa: cualquier endpoint OpenAI-compatible (vLLM, un modelo barato, etc.)
# AGENT_BASE_URL=https://tu-endpoint/v1
# AGENT_MODEL=nombre-del-modelo
# AGENT_API_KEY=tu-token
