# ---- Supabase (datos + acceso) ----
# Panel del proyecto: https://app.supabase.com -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# Clave de servicio: SOLO en el servidor. Nunca exponer al navegador ni commitear.
# Se usa en la Consola de Alta de Clientes para crear empresas e invitar usuarios.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# ---- App ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Controles de lanzamiento (todos bloqueados por defecto) ----
# Habilitar uno por uno solo despues de completar la lista de cumplimiento.
COMMERCIAL_PAYMENTS_ENABLED=false
META_PAUSED_DRAFTS_ENABLED=false
META_REAL_SPEND_ENABLED=false
AI_ASSISTANT_ENABLED=false
AI_WEB_TRENDS_ENABLED=false
AGENT_AUTOMATION_ENABLED=false

# ---- Inferencia gratuita de bajo volumen — OpenRouter ----
# Requiere una API key, pero el router openrouter/free no consume crédito.
# Las variantes gratuitas pueden tener menor disponibilidad y límites diarios.
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=minimax/minimax-m3:free
OPENROUTER_FALLBACK_MODELS=google/gemma-4-26b-a4b-it:free,openrouter/free
LLM_REQUEST_TIMEOUT_MS=17000

# ---- Vista geográfica de vallas ----
# Opcional: habilita el mapa de Google embebido. Es una clave pública de navegador;
# restringirla por dominio y exclusivamente a Maps Embed API. Sin ella se muestra
# OpenStreetMap y siguen disponibles los enlaces de Google Maps/Street View 360.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_API_KEY=

# ---- Alternativa DeepSeek directa ----
# Compatible con Mavi, pero la API comercial se factura por tokens.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# ---- Cobro real — dLocal Go Checkout estándar (solo servidor) ----
# Mantener sandbox hasta completar conciliación y una compra controlada.
DLOCALGO_ENV=sandbox
DLOCALGO_API_KEY=
DLOCALGO_SECRET_KEY=

# ---- Pauta real — Meta Marketing API (solo servidor) ----
# Token de sistema/long-lived con permisos aprobados de Marketing API.
META_APP_ID=1060704959998691
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=act_1234567890
META_PAGE_ID=
META_INSTAGRAM_USER_ID=
# Version estable habilitada para la app de Meta; se puede actualizar sin tocar codigo.
META_GRAPH_API_VERSION=v25.0
# Tope tanto para cobrar como para activar una orden individual.
META_MAX_CAMPAIGN_BUDGET_USD=500
META_CAMPAIGN_DURATION_DAYS=7

# ---- Asistente Mavi — Amazon Bedrock (recomendado) ----
# Modelo abierto en tu cuenta AWS, sin servidor. SOLO en el servidor.
# En Amplify usar un rol IAM para Bedrock; no cargar access keys de larga vida.
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=meta.llama3-1-8b-instruct-v1:0
# Solo para desarrollo local si no hay un perfil/rol AWS disponible:
BEDROCK_ACCESS_KEY_ID=
BEDROCK_SECRET_ACCESS_KEY=

# ---- Alternativa: modelo propio con endpoint tipo OpenAI (vLLM/Ollama/TGI) ----
# LLM_BASE_URL=
# LLM_MODEL=llama-3.1-8b-instruct
# LLM_API_KEY=

# ---- Agente ejecutor (worker) ----
# Token compartido entre el sitio y el agente de navegador (inventar uno largo).
AGENT_WORKER_TOKEN=

# ---- Ingesta de la base de inversion publicitaria (opcional) ----
# Solo necesarias para los conectores de scripts/ingest/connectors.
# No hacen falta para el sitio, la consola ni la importacion por CSV.

# El conector historico de Meta reutiliza META_ACCESS_TOKEN,
# META_AD_ACCOUNT_ID y META_GRAPH_API_VERSION definidos arriba.

# Google Ads API
# GOOGLE_ADS_DEVELOPER_TOKEN=
# GOOGLE_ADS_CUSTOMER_ID=
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# GOOGLE_ADS_OAUTH_ACCESS_TOKEN=
