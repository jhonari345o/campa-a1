# Copiar como admin-console/.env.local. Este archivo nunca se sube a Git.
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=TU_SERVICE_ROLE_KEY

# Protege el acceso a la consola local. Usa una frase larga y única.
LOCAL_ADMIN_PASSWORD=cambia-esta-frase-por-una-de-al-menos-16-caracteres

# Opcional. La consola siempre escucha solo en loopback.
LOCAL_ADMIN_PORT=4177
