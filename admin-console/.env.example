# Copiar como admin-console/.env.local. Este archivo nunca se sube a Git.
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=TU_SERVICE_ROLE_KEY

# Protege el acceso a la consola local. Usa una frase larga y única.
LOCAL_ADMIN_PASSWORD=cambia-esta-frase-por-una-de-al-menos-16-caracteres

# Opcional. La consola siempre escucha solo en loopback.
LOCAL_ADMIN_PORT=4177

# Perfil AWS local con permiso limitado para leer/actualizar variables de
# Amplify y lanzar un nuevo despliegue. No uses la cuenta root.
AWS_REGION=us-east-1
AWS_PROFILE=ad-mavericks-credentials
AMPLIFY_APP_ID=djk125z43ran7
AMPLIFY_BRANCH_NAME=claude/adsmaiber-website-admin-9xc3cv

# Alternativa a AWS_PROFILE: credenciales temporales o de un usuario IAM
# dedicado. Nunca copies estas variables al navegador ni al repositorio.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
